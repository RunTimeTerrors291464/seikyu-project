{
  "name": "seikyu-project-refactor",
  "version": "0.2.0",
  "description": "A refactored version of the Seikyu project, implementing a microservices architecture with NestJS. This project includes an API Gateway, a Platform service, and an Invoices service, all designed to work together seamlessly while maintaining clear separation of concerns.",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "build": "nest build",
    "build:all": "nest build platform && nest build api-gateway && nest build invoices",
    "build:platform": "nest build platform",
    "build:gateway": "nest build api-gateway",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:dev:platform": "nest start platform --watch",
    "start:dev:gateway": "nest start api-gateway --watch",
    "start:dev:invoices": "nest start invoices --watch",
    "start:dev:all": "concurrently --names \"PLATFORM,GATEWAY,INVOICES\" --prefix \"[{name}]\" --colors cyan,blue,green \"npm run start:dev:platform\" \"npm run start:dev:gateway\" \"npm run start:dev:invoices\"",
    "start:debug": "nest start --debug --watch",
    "start:debug:platform": "nest start platform --debug --watch",
    "start:debug:gateway": "nest start api-gateway --debug --watch",
    "start:debug:invoices": "nest start invoices --debug --watch",
    "start:prod:platform": "node dist/main.js",
    "start:prod:gateway": "node dist/main.js",
    "start:prod:invoices": "node dist/main.js",
    "start:prod:pm2": "npm run build:all && pm2 start ecosystem.config.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e:platform": "jest --config ./apps/platform/test/jest-e2e.json",
    "test:e2e:gateway": "jest --config ./apps/api-gateway/test/jest-e2e.json",
    "test:integration:platform": "npx jest --config ./apps/platform/test/jest-integration.json --runInBand --verbose",
    "db:check": "ts-node libs/migrations/src/scripts/checkDatabase.ts",
    "migration:create:gateway": "npm run typeorm -- migration:create libs/migrations/src/api-gateway/%MIGRATION_NAME%",
    "migration:generate:gateway": "npm run typeorm -- migration:generate libs/migrations/src/api-gateway/%MIGRATION_NAME% -d libs/migrations/src/scripts/dataSource.gateway.ts",
    "migration:run:gateway": "npm run typeorm -- migration:run -d libs/migrations/src/scripts/dataSource.gateway.ts",
    "migration:revert:gateway": "npm run typeorm -- migration:revert -d libs/migrations/src/scripts/dataSource.gateway.ts",
    "migration:show:gateway": "npm run typeorm -- migration:show -d libs/migrations/src/scripts/dataSource.gateway.ts",
    "migration:create:platform": "npm run typeorm -- migration:create libs/migrations/src/platform/%MIGRATION_NAME%",
    "migration:generate:platform": "npm run typeorm -- migration:generate libs/migrations/src/platform/%MIGRATION_NAME% -d libs/migrations/src/scripts/dataSource.platform.ts",
    "migration:run:platform": "npm run typeorm -- migration:run -d libs/migrations/src/scripts/dataSource.platform.ts",
    "migration:revert:platform": "npm run typeorm -- migration:revert -d libs/migrations/src/scripts/dataSource.platform.ts",
    "migration:show:platform": "npm run typeorm -- migration:show -d libs/migrations/src/scripts/dataSource.platform.ts",
    "migration:create:invoices": "npm run typeorm -- migration:create libs/migrations/src/invoices/%MIGRATION_NAME%",
    "migration:generate:invoices": "npm run typeorm -- migration:generate libs/migrations/src/invoices/%MIGRATION_NAME% -d libs/migrations/src/scripts/dataSource.invoices.ts",
    "migration:run:invoices": "npm run typeorm -- migration:run -d libs/migrations/src/scripts/dataSource.invoices.ts",
    "migration:revert:invoices": "npm run typeorm -- migration:revert -d libs/migrations/src/scripts/dataSource.invoices.ts",
    "migration:show:invoices": "npm run typeorm -- migration:show -d libs/migrations/src/scripts/dataSource.invoices.ts",
    "migration:run:all": "npm run migration:run:gateway && npm run migration:run:platform && npm run migration:run:invoices"
  },
  "dependencies": {
    "@nestjs-modules/ioredis": "^2.0.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.12",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^11.2.5",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@types/passport-jwt": "^4.0.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dotenv": "^17.3.1",
    "ioredis": "^5.9.2",
    "passport-jwt": "^4.0.1",
    "pg": "^8.18.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/common(|/.*)$": "<rootDir>/libs/common/src/$1",
      "^@app/migrations(|/.*)$": "<rootDir>/libs/migrations/src/$1",
      "^@app/services(|/.*)$": "<rootDir>/libs/services/src/$1"
    }
  }
}